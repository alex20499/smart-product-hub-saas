# Supabase 配置（前端需要，公开信息）
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key（创建 Auth 用户：seed-auth-users.js、/api/create-user）
# 在 Supabase Dashboard -> Project Settings -> API 获取
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gemini API Key（仅服务端使用，不会暴露在前端）
# 本地开发：配置后 Vite 中间件代理 /api/gemini
# 生产环境：配置在 Vercel 环境变量，Serverless Function 读取
GEMINI_API_KEY=your-gemini-api-key
